<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site_title }}</title>
  <link rel="stylesheet" href="style.css">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="{{ site_title }}" href="{{ feed_url }}">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GVXJH213L3"></script>
  <script>
   window.dataLayer = window.dataLayer || [];
   function gtag(){dataLayer.push(arguments);}
   gtag('js', new Date());

   gtag('config', 'G-GVXJH213L3');
  </script>
</head>
<body>
  <header class="masthead wrap">
    <h1><a href="{{ site_url }}">{{ site_title }}</a></h1>
    <p class="tagline">{{ site_tagline }}</p>
    <p class="subscribe"><a href="{{ feed_url }}">Suscribirse por RSS</a></p>
  </header>

  {% if site_photo_url %}
  <div class="masthead-photo wrap">
    {% if site_photo_link %}<a href="{{ site_photo_link }}">{% endif %}
      <img src="{{ site_photo_url }}" alt="{{ site_photo_alt }}" loading="lazy">
      {% if site_photo_caption %}<p class="masthead-photo-caption">{{ site_photo_caption }}</p>{% endif %}
    {% if site_photo_link %}</a>{% endif %}
  </div>
  {% endif %}

  <main class="grid wrap">
    {% for entry in entries %}
    <article class="card">
      <div class="card-info">
        <img class="favicon" src="{{ entry.favicon }}" alt="" width="24" height="24" loading="lazy">
        <div class="card-text">
          <a class="title" href="{{ entry.link }}" target="_blank" rel="noopener">{{ entry.title }}</a>
          <p class="source"><a href="{{ entry.site_url }}" target="_blank" rel="noopener">{{ entry.feed_title }}</a></p>
          <time class="stamp">{{ entry.relative_time }}</time>
        </div>
      </div>

      {% if entry.media_kind == "video" and entry.media_src %}
      <div class="media media-video">
        <iframe src="{{ entry.media_src }}" title="{{ entry.title }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
      {% elif entry.media_kind == "audio" and entry.media_src %}
      <div class="media media-audio">
        <iframe src="{{ entry.media_src }}" title="{{ entry.title }}" loading="lazy" scrolling="no" allow="autoplay; encrypted-media" referrerpolicy="no-referrer-when-downgrade" style="height: {{ entry.media_height or 200 }}px;"></iframe>
      </div>
      {% elif entry.media_kind == "audio_direct" and entry.media_src %}
      <div class="media media-audio-direct">
        <audio controls preload="none" src="{{ entry.media_src }}"></audio>
      </div>
      {% elif entry.media_kind == "image" and entry.media_image %}
      <a class="media media-thumb" href="{{ entry.link }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
        <img src="{{ entry.media_image }}" alt="" loading="lazy">
      </a>
      {% endif %}

      {% if entry.summary %}
      <p class="summary">{{ entry.summary }}</p>
      {% endif %}
    </article>
    {% else %}
    <p class="empty">No se ha podido leer ningún feed todavía.</p>
    {% endfor %}
  </main>

  <footer class="colophon wrap">
    <p>Actualizado el {{ generated_at }}</p>
    <p>Generado con Planet El Margen</p>
  </footer>
</body>
</html>
