<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site_title }}</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="masthead">
    <h1>{{ site_title }}</h1>
    <p class="tagline">{{ site_tagline }}</p>
  </header>

  <main class="dispatch">
    {% for entry in entries %}
    <article class="entry">
      <img class="favicon" src="{{ entry.favicon }}" alt="" width="16" height="16" loading="lazy">
      <div class="entry-body">
        <p class="source">{{ entry.feed_title }}</p>
        <a class="title" href="{{ entry.link }}" target="_blank" rel="noopener">{{ entry.title }}</a>

        {% if entry.media_kind == "video" and entry.media_src %}
        <div class="media media-video">
          <iframe src="{{ entry.media_src }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
        {% elif entry.media_kind == "audio" and entry.media_src %}
        <div class="media media-audio">
          <iframe src="{{ entry.media_src }}" loading="lazy" scrolling="no" allow="autoplay; encrypted-media" referrerpolicy="no-referrer-when-downgrade" style="height: {{ entry.media_height or 200 }}px;"></iframe>
        </div>
        {% elif entry.media_kind == "audio_direct" and entry.media_src %}
        <audio class="media-audio-direct" controls preload="none" src="{{ entry.media_src }}"></audio>
        {% elif entry.media_kind == "image" and entry.media_image %}
        <img class="media-thumb" src="{{ entry.media_image }}" alt="" loading="lazy">
        {% endif %}

        {% if entry.summary %}
        <p class="summary">{{ entry.summary }}</p>
        {% endif %}
      </div>
      <time class="stamp">{{ entry.relative_time }}</time>
    </article>
    {% else %}
    <p class="empty">No se ha podido leer ningún feed todavía.</p>
    {% endfor %}
  </main>

  <footer class="colophon">
    <p>Actualizado el {{ generated_at }}</p>
    <p>Generado con Planet El Margen</p>
  </footer>
</body>
</html>
</body>
</html>
